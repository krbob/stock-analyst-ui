{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>krbob/renovate-config:monthly"
  ],
  "packageRules": [
    {
      "description": "Keep TypeScript on v6 until the lint toolchain supports v7",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Group only patch-level frontend runtime updates",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Frontend runtime patches"
    },
    {
      "description": "Group only patch-level TypeScript type updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "TypeScript type patches"
    },
    {
      "description": "Group only patch-level frontend build tooling updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript",
        "vite",
        "@vitejs/plugin-react",
        "tailwindcss",
        "@tailwindcss/vite"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Frontend build tooling patches"
    },
    {
      "description": "Group only patch-level frontend test tooling updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@axe-core/playwright",
        "@playwright/test",
        "@testing-library/**",
        "jsdom",
        "vitest",
        "@vitest/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Frontend test tooling patches"
    },
    {
      "description": "Group only patch-level frontend linting updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "globals",
        "typescript-eslint"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Frontend linting patches"
    },
    {
      "description": "Group GitHub Actions patch and immutable digest refreshes",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions maintenance"
    },
    {
      "description": "Group immutable Docker digest refreshes only",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "Docker digest maintenance"
    }
  ]
}
